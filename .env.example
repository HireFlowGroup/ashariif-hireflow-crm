# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role — vereist voor Daily Intelligence cron & Company Finder discovery saves
SUPABASE_SERVICE_ROLE_KEY=

# Cron / worker authenticatie (Vercel Cron stuurt Authorization: Bearer CRON_SECRET)
CRON_SECRET=
WORKER_SECRET=

# Daily Hiring Intelligence Scheduler
DAILY_INTELLIGENCE_ENABLED=true
DAILY_INTELLIGENCE_CRON_SECRET_REQUIRED=true
DAILY_INTELLIGENCE_COMPANIES_PER_BATCH=100
DAILY_INTELLIGENCE_WORKER_BATCH_SIZE=5
DAILY_INTELLIGENCE_MAX_CONCURRENT_CHECKS=3
DAILY_INTELLIGENCE_DELAY_COMPANY_MS=2000
DAILY_INTELLIGENCE_DELAY_CHECK_MS=800
DAILY_INTELLIGENCE_STALE_JOB_MINUTES=30
DAILY_INTELLIGENCE_MAX_ATTEMPTS=3
DAILY_INTELLIGENCE_SCORE_CHANGE_THRESHOLD=5
DAILY_INTELLIGENCE_NOTIFY_SIGNAL_CREATE=true
DAILY_INTELLIGENCE_NOTIFY_SCORE_CHANGE=true

# OpenAI (optional — AI classificatie & samenvatting voor Lead Intelligence)
OPENAI_API_KEY=

# Recruitment Lead Intelligence — Provider keys
# Zoekproviders (fallback chain: Tavily → Brave → SerpAPI → Google CSE → Bing)
TAVILY_API_KEY=
WEB_SEARCH_API_KEY=
# BRAVE_SEARCH_API_KEY=  # alias
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BING_SEARCH_API_KEY=

# Crawlers (fallback chain: Firecrawl → Native → HTTP → Playwright)
FIRECRAWL_API_KEY=
PLAYWRIGHT_CRAWLER_ENABLED=false

# Platform (enterprise layer)
# Master key voor encrypted provider vault in Supabase (genereer: openssl rand -base64 32)
PROVIDER_SECRETS_ENCRYPTION_KEY=
API_RATE_LIMIT_PER_MINUTE=120
PLATFORM_CACHE_TTL_MS=300000
PLATFORM_MAX_RETRIES=2
OTEL_ENABLED=false
OTEL_SERVICE_NAME=hireflow-ai
LOG_LEVEL=info

# Provider tuning (optional)
PROVIDER_MAX_RETRIES=2
PROVIDER_RATE_LIMIT_PER_MINUTE=60
PROVIDER_CACHE_TTL_MS=300000

# Priority Engine (deterministic — configure weights & thresholds)
PRIORITY_WEIGHT_RECRUITMENT_ACTIVITY=18
PRIORITY_WEIGHT_GROWTH=10
PRIORITY_WEIGHT_HIRING_URGENCY=15
PRIORITY_WEIGHT_DIGITAL_PRESENCE=8
PRIORITY_WEIGHT_CONTACTABILITY=12
PRIORITY_WEIGHT_DECISION_MAKER=12
PRIORITY_WEIGHT_AI_MATCH=15
PRIORITY_WEIGHT_OUTREACH_DIFFICULTY=10
PRIORITY_THRESHOLD_A_MIN=85
PRIORITY_THRESHOLD_B_MIN=70
PRIORITY_THRESHOLD_C_MIN=50
PRIORITY_ENGINE_MODEL_VERSION=priority-engine-v1

# Legacy lead scoring env vars (fallback when PRIORITY_* unset)
LEAD_SCORE_WEIGHT_RECRUITMENT_ACTIVITY=20
LEAD_SCORE_WEIGHT_GROWTH=10
LEAD_SCORE_WEIGHT_URGENCY=15
LEAD_SCORE_WEIGHT_CONTACTABILITY=15
LEAD_SCORE_WEIGHT_DIGITAL_PRESENCE=10
LEAD_SCORE_WEIGHT_AI_MATCH=20
LEAD_SCORE_WEIGHT_OUTREACH_POTENTIAL=10
LEAD_SCORE_PRIORITY_A_MIN=85
LEAD_SCORE_PRIORITY_B_MIN=70
LEAD_SCORE_PRIORITY_C_MIN=50
LEAD_SCORE_MODEL_VERSION=deterministic-v2
COMPANY_FINDER_DEBUG=false
COMPANY_FINDER_MAX_RESULTS=50
COMPANY_FINDER_DISCOVERY_CONCURRENCY=4
COMPANY_FINDER_DISCOVERY_MAX_RESULTS_PER_PROVIDER=8
COMPANY_FINDER_DISCOVERY_TIMEOUT_MS=12000
COMPANY_FINDER_DISCOVERY_INGEST_CONCURRENCY=6
COMPANY_FINDER_PROVIDER_TIMEOUT_MS=20000
COMPANY_FINDER_ENRICHMENT_CONCURRENCY=5
COMPANY_FINDER_TAVILY_TIMEOUT_MS=10000
COMPANY_FINDER_CRAWLER_TIMEOUT_MS=8000
COMPANY_FINDER_AI_TIMEOUT_MS=12000
COMPANY_FINDER_COMPANY_PROCESSING_CONCURRENCY=5
COMPANY_FINDER_GLOBAL_JOB_TIMEOUT_MS=45000
COMPANY_FINDER_FAST_MODE_MAX_RESULTS=15

# Outreach Engine (safe-by-default — DRAFT_ONLY=true)
OUTREACH_DRAFT_ONLY=true
OUTREACH_SENDER_NAME=HireFlow Group
OUTREACH_SENDER_EMAIL=
OUTREACH_ALLOWED_SENDER_DOMAINS=
OUTREACH_DAILY_LIMIT=10
OUTREACH_COMPANY_COOLDOWN_DAYS=30
OUTREACH_MAX_RETRIES=2
OUTREACH_KILL_SWITCH=false
OUTREACH_ENFORCE_SEND_WINDOW=true
OUTREACH_TIMEZONE=Europe/Amsterdam
OUTREACH_BUSINESS_HOURS_START=08:30
OUTREACH_BUSINESS_HOURS_END=17:30

# Gmail OAuth (preferred when Strato mailbox is linked in Gmail)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=

# Strato SMTP fallback (only if Gmail OAuth unavailable)
SMTP_HOST=smtp.strato.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# AI Recruiter (safe-by-default)
AI_RECRUITER_APPROVAL_MODE=manual
AI_RECRUITER_SEND_ENABLED=false
AI_RECRUITER_RUN_TIMEOUT_MINUTES=45
AI_RECRUITER_MAX_CONCURRENT_ITEMS=3
AI_RECRUITER_PROVIDER_FAILURE_KILL_SWITCH=3
AI_RECRUITER_DEFAULT_MAX_COMPANIES=25
AI_RECRUITER_DEFAULT_MAX_DRAFTS=10
